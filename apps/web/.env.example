# Supabase (Plan 02 will populate the local dev project values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# OTP adapter (Phase 2 will use this)
OTP_PROVIDER=stub

# After `supabase start`, paste the values from `supabase status` here:
#   API URL → NEXT_PUBLIC_SUPABASE_URL
#   anon key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   service_role key → SUPABASE_SERVICE_ROLE_KEY (server-only, NEVER NEXT_PUBLIC_)
# DB direct URL is for migrations / type generation only:
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
